---
import { useTranslations, localePath, type Lang } from '../i18n/ui';
import { site, whatsappLink } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<section class="contact" id="contato">
  <div class="container">
    <p class="status">
      <span class="pulse" aria-hidden="true"></span>
      {t('hero.status')}
    </p>
    <h2 class="title">{t('contact.title')}</h2>
    <p class="body">{t('contact.body')}</p>

    <div class="ctas">
      <a class="btn btn--solid" href={whatsappLink(t('contact.message'))} target="_blank" rel="noopener">
        {t('contact.whatsapp')} ↗
      </a>
      <a class="btn btn--ghost" href={`mailto:${site.email}`}>{t('contact.email')}</a>
    </div>
    <p class="email">{site.email}</p>

    <footer class="footer">
      <div class="footer__id">
        <a class="footer__logo" href={localePath(lang)}>MF</a>
        <span>Belo Horizonte, MG</span>
      </div>
      <nav class="footer__links" aria-label="Links">
        <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={site.github} target="_blank" rel="noopener">GitHub</a>
        <a href={site.cv} download>CV</a>
      </nav>
      <p class="footer__copy">© {year} {t('footer.rights')}</p>
    </footer>
  </div>
</section>

<style>
  .contact {
    padding: 120px 0 40px;
    background: var(--ink);
    color: var(--text-on-ink);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 32px;
    padding: 6px 14px 6px 12px;
    border: 1px solid var(--ink-line);
    border-radius: var(--pill);
    font-size: 13px;
    color: var(--text-on-ink-muted);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--live);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--live);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  .title {
    margin: 0 0 20px;
    max-width: 820px;
    font-size: clamp(36px, 5.6vw, 72px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .body {
    margin: 0 0 40px;
    font-size: 18px;
    color: var(--text-on-ink-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn {
    padding: 15px 28px;
    border-radius: var(--pill);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition:
      opacity 0.2s,
      border-color 0.2s;
  }

  .btn--solid {
    background: var(--text-on-ink);
    color: var(--ink);
  }

  .btn--solid:hover {
    opacity: 0.85;
  }

  .btn--ghost {
    border: 1px solid #333;
  }

  .btn--ghost:hover {
    border-color: #666;
  }

  .email {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: #5c5c5c;
  }

  .footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px 24px;
    margin-top: 120px;
    padding-top: 28px;
    border-top: 1px solid var(--ink-line);
    font-size: 14px;
    color: var(--text-on-ink-muted);
  }

  .footer__id {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .footer__logo {
    color: var(--text-on-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .footer__links {
    display: flex;
    gap: 24px;
  }

  .footer__links a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__links a:hover {
    color: var(--text-on-ink);
  }

  .footer__copy {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #5c5c5c;
  }

  @media (max-width: 640px) {
    .contact {
      padding-top: 88px;
    }

    .footer {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 80px;
    }
  }
</style>
