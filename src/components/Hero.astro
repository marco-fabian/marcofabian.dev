---
import { useTranslations, localePath, type Lang } from '../i18n/ui';
import Nav from './Nav.astro';
import AgentDemo from './AgentDemo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);
---

<section class="hero">
  <Nav lang={lang} />

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__status">
        <span class="hero__pulse" aria-hidden="true"></span>
        {t('hero.status')}
      </p>
      <p class="hero__eyebrow">{t('hero.eyebrow')}</p>
      <h1 class="hero__title">{t('hero.title')}</h1>
      <p class="hero__subtitle">{t('hero.subtitle')}</p>
      <div class="hero__ctas">
        <a class="btn btn--solid" href={`${home}#cases`}>{t('hero.ctaPrimary')}</a>
        <a class="btn btn--ghost" href={`${home}#contato`}>{t('hero.ctaSecondary')}</a>
      </div>
    </div>

    <div class="hero__demo">
      <AgentDemo lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--ink);
    color: var(--text-on-ink);
    padding: 140px 0 96px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 6px 14px 6px 12px;
    border: 1px solid var(--ink-line);
    border-radius: var(--pill);
    font-size: 13px;
    color: var(--text-on-ink-muted);
  }

  .hero__pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--live);
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--live);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  .hero__eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-on-ink-muted);
  }

  .hero__title {
    margin: 0 0 20px;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero__subtitle {
    margin: 0 0 36px;
    max-width: 460px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-on-ink-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn {
    padding: 14px 26px;
    border-radius: var(--pill);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition:
      opacity 0.2s,
      border-color 0.2s;
  }

  .btn--solid {
    background: var(--text-on-ink);
    color: var(--ink);
  }

  .btn--solid:hover {
    opacity: 0.85;
  }

  .btn--ghost {
    border: 1px solid #333;
  }

  .btn--ghost:hover {
    border-color: #666;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 112px 0 64px;
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
  }
</style>
