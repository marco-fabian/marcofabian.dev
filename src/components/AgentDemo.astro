---
import { useTranslations, type Lang } from '../i18n/ui';
import { agentDemo, type DemoStep } from '../data/agent-demo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const scenarios = agentDemo[lang];

const logLine = (line: string) => {
  const [time, ...rest] = line.split(' ');
  const body = rest.join(' ');
  const cls = body.startsWith('✓') ? 'ok' : body.startsWith('→') ? 'tool' : '';
  return { time, body, cls };
};
const convs: { scenario: string; key: string; steps: DemoStep[] }[] = scenarios.flatMap((s) =>
  s.conversations.map((steps, i) => ({ scenario: s.id, key: `${s.id}:${i}`, steps }))
);
---

<div class="demo" data-demo data-view="chat">
  <div class="demo__bar">
    <span class="demo__label">
      <span class="demo__dot" aria-hidden="true"></span>
      <span data-label-chat>{t('demo.chatLabel')}</span>
      <span data-label-log>{t('demo.logLabel')}</span>
    </span>
    <button class="demo__toggle" type="button" data-toggle>
      <span data-label-chat>{t('demo.toInside')}</span>
      <span data-label-log>{t('demo.toChat')}</span>
    </button>
  </div>

  <div class="demo__tabs" role="group" aria-label={t('demo.scenarios')}>
    {
      scenarios.map((s) => (
        <button class="demo__tab" type="button" data-tab={s.id} aria-pressed="false">
          {s.label}
        </button>
      ))
    }
  </div>

  <div class="demo__screen">
    {
      convs.map((c) => (
        <div class="conv" data-conv={c.key} data-scenario={c.scenario} aria-hidden="true">
          <ol class="demo__chat" aria-label={t('demo.chatLabel')}>
            {c.steps.map((s, i) => (
              <li class={`bubble bubble--${s.chat.kind}`} data-step={i}>
                {s.chat.text}
              </li>
            ))}
          </ol>
          <ol class="demo__log" aria-label={t('demo.logLabel')}>
            {c.steps.map((s, i) =>
              s.log.map((line) => {
                const l = logLine(line);
                return (
                  <li class="line" data-step={i}>
                    <span class="line__time">{l.time}</span> <span class={l.cls}>{l.body}</span>
                  </li>
                );
              })
            )}
          </ol>
        </div>
      ))
    }
  </div>
</div>

<script>
  const STEP_MS = 1100;
  const RESTART_MS = 4500;

  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((root) => {
    const convs = [...root.querySelectorAll<HTMLElement>('[data-conv]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let pinned: string | null = null; // cenário escolhido pelo visitante
    let current: HTMLElement | undefined;
    let steps: HTMLElement[] = [];
    let total = 0;
    let step = -1;
    let timer: number;
    let visible = false;

    // "Baralho": cada conversa só volta depois de todas as outras (do cenário fixado, se houver)
    // terem aparecido, e nunca repete a atual na virada do baralho.
    const seen = new Set<HTMLElement>();
    const pick = () => {
      const pool = convs.filter((c) => !pinned || c.dataset.scenario === pinned);
      let unseen = pool.filter((c) => !seen.has(c));
      if (!unseen.length) {
        pool.forEach((c) => seen.delete(c));
        unseen = pool.filter((c) => c !== current);
      }
      const next = unseen[Math.floor(Math.random() * unseen.length)] ?? pool[0];
      seen.add(next);
      return next;
    };

    const show = (n: number) => steps.forEach((el) => el.classList.toggle('is-on', Number(el.dataset.step) <= n));

    const activate = (conv: HTMLElement) => {
      current = conv;
      convs.forEach((c) => {
        const on = c === conv;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-hidden', String(!on));
      });
      tabs.forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.tab === conv.dataset.scenario)));
      steps = [...conv.querySelectorAll<HTMLElement>('[data-step]')];
      total = Math.max(...steps.map((el) => Number(el.dataset.step))) + 1;
      step = -1;
      show(reduced ? total - 1 : -1);
    };

    const tick = () => {
      step += 1;
      if (step >= total) {
        activate(pick());
        timer = window.setTimeout(tick, 600);
        return;
      }
      show(step);
      timer = window.setTimeout(tick, step === total - 1 ? RESTART_MS : STEP_MS);
    };

    root.querySelector('[data-toggle]')?.addEventListener('click', () => {
      root.dataset.view = root.dataset.view === 'chat' ? 'log' : 'chat';
    });

    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        pinned = tab.dataset.tab ?? null;
        window.clearTimeout(timer);
        current = undefined;
        activate(pick());
        if (!reduced && visible) timer = window.setTimeout(tick, 300);
      })
    );

    activate(pick());
    if (reduced) return;

    // Só anima quando o demo está visível
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      window.clearTimeout(timer);
      if (visible) timer = window.setTimeout(tick, 500);
    }).observe(root);
  });
</script>

<style>
  .demo {
    width: 100%;
    border: 1px solid var(--ink-line);
    border-radius: 16px;
    background: #050505;
    overflow: hidden;
  }

  .demo__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--ink-line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-on-ink-muted);
  }

  .demo__label {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .demo__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
  }

  .demo__toggle,
  .demo__tab {
    all: unset;
    cursor: pointer;
    padding: 4px 10px;
    border: 1px solid var(--ink-line);
    border-radius: var(--pill);
    transition:
      border-color 0.2s,
      background 0.2s,
      color 0.2s;
  }

  .demo__toggle {
    color: var(--text-on-ink);
  }

  .demo__toggle:hover,
  .demo__toggle:focus-visible,
  .demo__tab:hover,
  .demo__tab:focus-visible {
    border-color: #555;
  }

  .demo[data-view='chat'] [data-label-log],
  .demo[data-view='log'] [data-label-chat] {
    display: none;
  }

  .demo__tabs {
    display: flex;
    gap: 8px;
    padding: 12px 16px 0;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .demo__tab {
    color: var(--text-on-ink-muted);
  }

  .demo__tab[aria-pressed='true'] {
    background: var(--text-on-ink);
    border-color: var(--text-on-ink);
    color: var(--ink);
  }

  /* Todas as conversas e as duas visões ocupam a mesma célula do grid: a tela fica com a
     altura da conversa mais longa, o espaço já está reservado e nada rola nem pula. */
  .demo__screen,
  .conv {
    display: grid;
  }

  .conv {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .conv.is-active {
    visibility: visible;
    opacity: 1;
  }

  .demo__chat,
  .demo__log {
    grid-area: 1 / 1;
    margin: 0;
    padding: 16px 20px 20px;
    list-style: none;
    transition: opacity 0.35s;
  }

  .demo[data-view='chat'] .demo__log,
  .demo[data-view='log'] .demo__chat {
    opacity: 0;
    pointer-events: none;
  }

  .demo__chat {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bubble,
  .line {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }

  .bubble.is-on,
  .line.is-on {
    opacity: 1;
    transform: none;
  }

  .bubble {
    max-width: 78%;
    padding: 9px 14px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.45;
  }

  .bubble--in {
    align-self: flex-start;
    background: #1c1c1c;
    color: var(--text-on-ink);
    border-bottom-left-radius: 4px;
  }

  .bubble--out {
    align-self: flex-end;
    background: var(--text-on-ink);
    color: var(--ink);
    border-bottom-right-radius: 4px;
  }

  .bubble--tool {
    align-self: center;
    max-width: 100%;
    padding: 3px 12px;
    border: 1px solid var(--ink-line);
    font-family: var(--font-mono);
    font-size: 11px;
    text-align: center;
    color: var(--text-on-ink-muted);
  }

  .demo__log {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.8;
    color: #cfcfcf;
  }

  .line__time {
    color: #5c5c5c;
  }

  .tool {
    color: #fff;
  }

  .ok {
    color: var(--live);
  }
</style>
