---
import { useTranslations, type Lang } from '../i18n/ui';
import { services } from '../data/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { featured, others, steps } = services[lang];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="services" id="servicos">
  <div class="container">
    <p class="eyebrow">{t('services.eyebrow')}</p>
    <h2 class="title">{t('services.title')}</h2>

    <article class="feat">
      <div class="feat__copy">
        <h3 class="feat__title">{featured.title}</h3>
        <p class="feat__body">{featured.body}</p>
        <p class="tags">{featured.tags.join(' · ')}</p>
      </div>

      <div class="shifts">
        <p class="shifts__label">{t('services.shiftsLabel')}</p>
        <ul>
          {
            featured.shifts.map((s) => (
              <li class="shift">
                <span class="shift__from">{s.from}</span>
                <span class="shift__to">{s.to}</span>
                <span class="shift__label">{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <ul class="grid">
      {
        others.map((s) => (
          <li class="card">
            <h3 class="card__title">{s.title}</h3>
            <p class="card__body">{s.body}</p>
            <p class="tags">{s.tags.join(' · ')}</p>
          </li>
        ))
      }
    </ul>

    <div class="process">
      <p class="eyebrow">{t('services.processEyebrow')}</p>
      <h3 class="process__title">{t('services.processTitle')}</h3>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__n">{pad(i + 1)}</span>
              <span class="step__title">{s.title}</span>
              <span class="step__body">{s.body}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .services {
    padding: 32px 0 112px;
  }

  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-on-paper-muted);
  }

  .title {
    margin: 0 0 40px;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .tags {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #a3a3a3;
  }

  /* destaque: agentes */
  .feat {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 48px;
    padding: 40px;
    border-radius: 16px;
    background: var(--ink);
    color: var(--text-on-ink);
  }

  .feat__title {
    margin: 0 0 14px;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .feat__body {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-on-ink-muted);
  }

  .feat .tags {
    color: #6b6b6b;
  }

  .shifts__label {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #6b6b6b;
  }

  .shift {
    display: grid;
    grid-template-columns: 120px 90px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 16px 0;
    border-top: 1px solid var(--ink-line);
  }

  .shift__from {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #5c5c5c;
    text-decoration: line-through;
  }

  .shift__to {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--live);
  }

  .shift__label {
    font-size: 14px;
    color: var(--text-on-ink-muted);
  }

  /* grade de serviços */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border: 1px solid var(--paper-line);
    border-radius: 16px;
    background: var(--paper-2);
  }

  .card__title {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .card__body {
    margin: 0 0 6px;
    flex: 1;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-on-paper-muted);
  }

  /* como funciona */
  .process {
    margin-top: 96px;
  }

  .process__title {
    margin: 0 0 32px;
    max-width: 640px;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    counter-reset: step;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid #111;
  }

  .step__n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #a3a3a3;
  }

  .step__title {
    font-size: 18px;
    font-weight: 600;
  }

  .step__body {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-on-paper-muted);
  }

  @media (max-width: 900px) {
    .feat {
      grid-template-columns: minmax(0, 1fr);
      padding: 28px 22px;
      gap: 28px;
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .grid,
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .shift {
      grid-template-columns: 76px minmax(0, 1fr);
      row-gap: 2px;
    }

    .shift__from {
      grid-column: 1 / -1;
    }
  }
</style>
