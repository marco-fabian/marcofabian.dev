---
import '../styles/global.css';
import { useTranslations, localePath, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Caminho sem prefixo de idioma, usado para canonical e hreflang. */
  path?: string;
  /** Imagem de compartilhamento, relativa ao site (ex.: /og/home-pt.png). */
  ogImage?: string;
}

const { lang, title, description, path = '/', ogImage = `/og/home-${lang}.png` } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(localePath(lang, path), Astro.site);
const image = new URL(ogImage, Astro.site);
const locales = Object.keys(languages) as Lang[];
const ogLocale = { pt: 'pt_BR', en: 'en_US' } as const;
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#000000" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('pt', path), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marco Fabian" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <slot />
  </body>
</html>
